# Audit Service Configuration

# Service Identity
SERVICE_NAME=audit-service
SERVICE_VERSION=1.0.0

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/authless

# NATS Configuration
NATS_URL=nats://127.0.0.1:4222
NATS_STREAM_NAME=EVENTS
AUDIT_CONSUMER_NAME=audit-consumer

# Processing Configuration
AUDIT_CONCURRENCY=8
AUDIT_BATCH_SIZE=100
AUDIT_ACK_WAIT_MS=30000

# Retry Configuration
AUDIT_MAX_RETRIES=10
AUDIT_RETRY_DELAY_MS=1000

# Health Check Configuration
HEALTH_CHECK_INTERVAL_MS=10000

# Server Configuration
PORT=8082
METRICS_PORT=9090

# Logging Configuration
LOG_LEVEL=info

# Default Values (for missing event data)
DEFAULT_SERVICE=audit-service
DEFAULT_VERSION=1.0.0

# Security Configuration (if needed)
# JWT_SECRET=your-jwt-secret-here
# API_KEY=your-api-key-here

# Environment
NODE_ENV=production