{
  "name": "@jetstream/email-service",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/start.ts",
    "clean": "rm -rf dist",
    "start": "node dist/start.js",
    "start:dev": "tsc && node dist/start.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@jetstream/email-consumer": "workspace:*",
    "@jetstream/service-wrapper": "workspace:*",
    "nats": "^2.28.2",
    "pg": "^8.11.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.10.0",
    "@types/react": "^18.2.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}