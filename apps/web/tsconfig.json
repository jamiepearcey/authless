{
  "extends": "../../packages/config/tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@ui/*": [
        "../../packages/ui/src/*"
      ],
      "@trpc/*": [
        "../../packages/trpc/src/*"
      ],
      "@shared/*": [
        "../../packages/shared/src/*"
      ],
      "@db/*": [
        "../../packages/db/src/*"
      ],
      "@i18n-core/*": [
        "./packages/i18n-core/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "app/.next/types/**/*.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
