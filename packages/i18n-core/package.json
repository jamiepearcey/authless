{
  "name": "@i18n-core",
  "private": true,
  "type": "module",
  "main": "./src/server.ts",
  "types": "./src/server.ts",
  "exports": {
    ".": {
      "react-server": {
        "types": "./src/server.ts",
        "import": "./src/server.ts",
        "require": "./src/server.ts"
      },
      "browser": {
        "types": "./src/client.ts",
        "import": "./src/client.ts",
        "require": "./src/client.ts"
      },
      "default": {
        "types": "./src/client.ts",
        "import": "./src/client.ts",
        "require": "./src/client.ts"
      }
    }
  },
  "scripts": {
    "i18n:process": "tsx src/scripts/i18n-process.ts",
    "i18n:generate": "tsx src/scripts/i18n-gen.ts",
    "i18n:translate": "tsx src/scripts/translate-missing.ts",
    "i18n:scan": "tsx src/scripts/auto-scan.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@babel/parser": "^7.25.0",
    "@babel/traverse": "^7.28.3",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "fast-glob": "^3.3.2",
    "i": "^0.3.7",
    "jsdom": "^26.1.0",
    "prettier": "^3.3.3",
    "recast": "^0.23.9",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@babel/generator": "^7.28.3",
    "@babel/types": "^7.28.2",
    "@types/jsonwebtoken": "^9.0.0",
    "diff": "^8.0.2",
    "glob": "^11.0.3",
    "jsonwebtoken": "^9.0.0",
    "next": "14.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "server-only": "^0.0.1"
  }
}