# Example Dockerfile for JetStream services using the service wrapper
# This file demonstrates how to containerize services built with the jetstream-service-wrapper

FROM node:18-alpine AS base

# Install dependencies only when needed
FROM base AS deps
# Check https://github.com/nodejs/docker-node/tree/b4117f9333da4138b03a546ec926ef50a31506c3#nodealpine to understand why libc6-compat might be needed.
RUN apk add --no-cache libc6-compat
WORKDIR /app

# Install dependencies based on the preferred package manager
COPY package.json pnpm-lock.yaml* ./
RUN corepack enable pnpm && pnpm i --frozen-lockfile

# Rebuild the source code only when needed
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Build the service
RUN corepack enable pnpm && pnpm run build

# Production image, copy all the files and run the service
FROM base AS runner
WORKDIR /app

ENV NODE_ENV production

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 service

# Copy built application
COPY --from=builder --chown=service:nodejs /app/dist ./dist
COPY --from=builder --chown=service:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=service:nodejs /app/package.json ./package.json

USER service

# Health check using Lightship endpoints
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:${LIGHTSHIP_PORT:-9000}/health || exit 1

# Lightship will handle graceful shutdown
STOPSIGNAL SIGTERM

# Environment variables for service configuration
ENV NATS_URL=nats://nats:4223
ENV LIGHTSHIP_PORT=9000
ENV LOG_LEVEL=info
ENV STRUCTURED_LOGGING=true
ENV METRICS_ENABLED=true
ENV SERVICE_CONCURRENCY=10
ENV SERVICE_BATCH_SIZE=50

# Expose Lightship port for health checks and metrics
EXPOSE 9000

CMD ["node", "dist/index.js"]