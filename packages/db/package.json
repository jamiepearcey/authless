{
  "name": "@db/base",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:studio": "prisma studio",
    "prisma:push": "prisma db push",
    "db:seed": "tsx src/seed.ts",
    "db:seed:simple": "tsx src/seed-simple.ts",
    "db:seed:contact-reasons": "tsx src/seed-contact-reasons.ts",
    "db:seed:multi-tenancy": "tsx src/seed-multi-tenancy.ts",
    "db:switch:postgresql": "cp prisma/schema.postgresql.prisma prisma/schema.prisma",
    "db:switch:sqlite": "cp prisma/schema.sqlite.prisma prisma/schema.prisma",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^5.7.0",
    "bcryptjs": "^2.4.3",
    "@shared/base": "workspace:*"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "prisma": "^5.7.0",
    "ts-node": "^10.9.0",
    "tsx": "^4.6.0",
    "vitest": "^1.0.0"
  }
}
