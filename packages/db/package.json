{
  "name": "@db/base",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:studio": "prisma studio",
    "prisma:push": "prisma db push",
    "db:seed": "tsx src/seed.ts",
    "db:seed:simple": "tsx src/seed-simple.ts",
    "db:seed:contact-reasons": "tsx src/seed-contact-reasons.ts",
    "db:seed:multi-tenancy": "tsx src/seed-multi-tenancy.ts",
    "db:setup": "tsx -e \"import { setupDatabase } from './src/setup-functions'; setupDatabase().catch(console.error)\"",
    "db:test": "tsx -e \"import { testDatabaseFunctions } from './src/setup-functions'; testDatabaseFunctions().catch(console.error)\"",
    "db:switch:postgresql": "cp prisma/schema.postgresql.prisma prisma/schema.prisma",
    "db:switch:sqlite": "cp prisma/schema.sqlite.prisma prisma/schema.prisma",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@shared/base": "workspace:*",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.2.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/dotenv": "^8.2.3",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "vitest": "^1.6.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
