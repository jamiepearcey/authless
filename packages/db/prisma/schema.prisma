generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  tenantId     String?
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model User {
  id                     String                  @id @default(cuid())
  name                   String?
  email                  String?                 @unique
  emailVerified          DateTime?
  image                  String?
  hashedPassword         String?
  isEmailVerified        Boolean                 @default(false)
  emailVerificationToken String?                 @unique
  passwordResetToken     String?                 @unique
  passwordResetExpires   DateTime?
  platformRole           String?
  status                 String                  @default("active")
  lastLoginAt            DateTime?
  twoFactorSecret        String?
  twoFactorEnabled       Boolean                 @default(false)
  
  // Profile fields
  bio                    String?
  location               String?
  website                String?
  timezone               String                  @default("UTC")
  locale                 String                  @default("en")
  
  // Notification preferences
  emailNotifications     Boolean                 @default(true)
  marketingEmails        Boolean                 @default(false)
  securityAlerts         Boolean                 @default(true)
  activityUpdates        Boolean                 @default(false)
  
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  accounts               Account[]
  auditLogs              AuditLog[]
  authenticatorCodes     AuthenticatorCode[]
  contactMessages        ContactMessage[]
  sentInvitations        Invitation[]            @relation("InvitedBy")
  acceptedInvitations    Invitation[]            @relation("InvitationAcceptedBy")
  memberships            Membership[]
  invitedMemberships     Membership[]            @relation("InvitedBy")
  notifications          Notification[]
  notificationRecipients NotificationRecipient[]
  passkeys               Passkey[]
  sessions               Session[]

  @@index([email])
  @@index([platformRole])
  @@index([status])
  @@index([lastLoginAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Tenant {
  id                             String            @id @default(cuid())
  slug                           String            @unique
  name                           String
  status                         String            @default("active")
  subdomain                      String?           @unique
  customDomain                   String?           @unique
  logoUrl                        String?
  theme                          String?
  primaryColor                   String?
  secondaryColor                 String?
  invitePolicy                   String            @default("admin_only")
  emailVerificationBypassEnabled Boolean           @default(false)
  locale                         String            @default("en")
  timezone                       String            @default("UTC")
  plan                           String            @default("free")
  limits                         String?
  featureFlags                   String?
  ssoEnabled                     Boolean           @default(false)
  ssoProvider                    String?
  billingEnabled                 Boolean           @default(false)
  stripeCustomerId               String?
  currentPeriodStart             DateTime?
  currentPeriodEnd               DateTime?
  cancelAtPeriodEnd              Boolean           @default(false)
  description                    String?
  website                        String?
  industry                       String?
  size                           String?
  createdAt                      DateTime          @default(now())
  updatedAt                      DateTime          @updatedAt
  suspendedAt                    DateTime?
  deletedAt                      DateTime?
  auditLogs                      AuditLog[]
  contactMessages                ContactMessage[]
  contactReasons                 ContactReason[]
  invitations                    Invitation[]
  memberships                    Membership[]
  notifications                  Notification[]
  sessions                       Session[]
  webhookEndpoints               WebhookEndpoint[]
  featureRules                   TenantFeatureRule[]
  featureAuditEntries           FeatureAuditEntry[]

  @@index([slug])
  @@index([subdomain])
  @@index([status])
  @@index([plan])
  @@index([createdAt])
  @@index([suspendedAt])
  @@index([deletedAt])
}

model Membership {
  id                   String    @id @default(cuid())
  tenantId             String
  userId               String
  role                 String
  status               String    @default("active")
  permissions          String?
  invitedByUserId      String?
  invitationAcceptedAt DateTime?
  lastActiveAt         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy            User?     @relation("InvitedBy", fields: [invitedByUserId], references: [id])

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@index([role])
  @@index([status])
  @@index([lastActiveAt])
}

model Invitation {
  id                      String    @id @default(cuid())
  tenantId                String
  email                   String
  role                    String
  token                   String    @unique
  expiresAt               DateTime
  bypassEmailVerification Boolean   @default(false)
  status                  String    @default("pending")
  message                 String?
  acceptedAt              DateTime?
  acceptedByUserId        String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  invitedByUserId         String
  tenant                  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy               User      @relation("InvitedBy", fields: [invitedByUserId], references: [id])
  acceptedBy              User?     @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id])

  @@index([tenantId])
  @@index([email])
  @@index([token])
  @@index([status])
  @@index([expiresAt])
  @@index([createdAt])
}

model ContactReason {
  id              String                 @id @default(cuid())
  key             String                 @unique
  label           String
  description     String
  icon            String
  isActive        Boolean                @default(true)
  sortOrder       Int                    @default(0)
  tenantId        String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  contactMessages ContactMessageReason[]
  tenant          Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([isActive])
  @@index([sortOrder])
}

model ContactMessage {
  id         String                 @id @default(cuid())
  name       String
  email      String
  subject    String
  message    String
  userId     String?
  tenantId   String?
  status     String                 @default("open")
  priority   String                 @default("normal")
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  assignedTo String?
  category   String?
  dueDate    DateTime?
  resolvedAt DateTime?
  tags       String?
  user       User?                  @relation(fields: [userId], references: [id])
  tenant     Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reasons    ContactMessageReason[]
  replies    ContactReply[]

  @@index([userId])
  @@index([tenantId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([assignedTo])
  @@index([createdAt])
  @@index([resolvedAt])
}

model ContactMessageReason {
  id               String         @id @default(cuid())
  contactMessageId String
  contactReasonId  String
  createdAt        DateTime       @default(now())
  contactMessage   ContactMessage @relation(fields: [contactMessageId], references: [id], onDelete: Cascade)
  contactReason    ContactReason  @relation(fields: [contactReasonId], references: [id], onDelete: Cascade)

  @@unique([contactMessageId, contactReasonId])
  @@index([contactMessageId])
  @@index([contactReasonId])
}

model ContactReply {
  id               String         @id @default(cuid())
  contactMessageId String
  message          String
  isFromUser       Boolean        @default(false)
  isInternal       Boolean        @default(false)
  attachments      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  contactMessage   ContactMessage @relation(fields: [contactMessageId], references: [id], onDelete: Cascade)

  @@index([contactMessageId])
  @@index([isFromUser])
  @@index([isInternal])
  @@index([createdAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  tenantId     String?
  userId       String
  action       String
  resourceType String?
  resourceId   String?
  details      String?
  ipAddress    String?
  userAgent    String?
  metadata     String?
  severity     String   @default("info")
  createdAt    DateTime @default(now())
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([resourceType])
  @@index([severity])
  @@index([createdAt])
}

model Passkey {
  id               String    @id @default(cuid())
  userId           String
  name             String
  credentialId     String    @unique
  publicKey        String
  signCount        Int       @default(0)
  transports       String?
  backupEligible   Boolean   @default(false)
  backupState      Boolean   @default(false)
  userVerification String    @default("preferred")
  isActive         Boolean   @default(true)
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([credentialId])
  @@index([isActive])
  @@index([lastUsedAt])
  @@index([createdAt])
}

model AuthenticatorCode {
  id         String    @id @default(cuid())
  userId     String
  name       String
  secret     String
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@index([createdAt])
}

model Notification {
  id          String                  @id @default(cuid())
  title       String
  description String?
  type        String                  @default("info")
  priority    String                  @default("normal")
  status      String                  @default("unread")
  tenantId    String?
  role        String?
  userId      String?
  metadata    String?
  expiresAt   DateTime?
  readAt      DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  user        User?                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipients  NotificationRecipient[]

  @@index([tenantId])
  @@index([role])
  @@index([userId])
  @@index([type])
  @@index([priority])
  @@index([status])
  @@index([expiresAt])
  @@index([createdAt])
}

model NotificationRecipient {
  id             String       @id @default(cuid())
  notificationId String
  userId         String
  status         String       @default("unread")
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([notificationId])
  @@index([userId])
  @@index([status])
  @@index([readAt])
  @@index([createdAt])
}

model WebhookEndpoint {
  id              String    @id @default(cuid())
  tenantId        String?
  name            String
  url             String
  secret          String?
  events          String
  isActive        Boolean   @default(true)
  lastTriggeredAt DateTime?
  failureCount    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tenant          Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([isActive])
  @@index([lastTriggeredAt])
  @@index([createdAt])
}

// Feature Toggle System Models

model FeatureDefinition {
  id          String @id @default(cuid())
  key         String @unique // e.g., "notifications", "sso", "discussion_wall"
  name        String // Human-readable name
  description String? // Description of the feature
  tier        String // "Core", "Secondary", "Tenancy-only"
  defaultEnabled Boolean @default(false) // Default state for new tenants
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String // User ID who created this feature
  
  // Relations
  globalRules GlobalFeatureRule[]
  tenantRules TenantFeatureRule[]
  auditEntries FeatureAuditEntry[]
  
  @@index([tier])
  @@index([defaultEnabled])
  @@index([createdAt])
}

model GlobalFeatureRule {
  id        String @id @default(cuid())
  featureKey String // References FeatureDefinition.key
  enabled   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String // User ID who created/modified this rule
  
  // Relations
  feature   FeatureDefinition @relation(fields: [featureKey], references: [key], onDelete: Cascade)
  
  @@unique([featureKey]) // Only one global rule per feature
  @@index([enabled])
  @@index([createdAt])
}

model TenantFeatureRule {
  id        String @id @default(cuid())
  tenantId  String
  featureKey String // References FeatureDefinition.key
  enabled   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String // User ID who created/modified this rule
  
  // Relations
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feature   FeatureDefinition @relation(fields: [featureKey], references: [key], onDelete: Cascade)
  
  @@unique([tenantId, featureKey]) // Only one rule per tenant per feature
  @@index([tenantId])
  @@index([enabled])
  @@index([createdAt])
}

model FeatureAuditEntry {
  id          String @id @default(cuid())
  featureKey  String // References FeatureDefinition.key
  scope       String // "global" or "tenant"
  tenantId    String? // Null for global scope
  beforeValue String? // JSON representation of previous state
  afterValue  String? // JSON representation of new state
  action      String // "create", "update", "delete", "enable", "disable"
  createdAt   DateTime @default(now())
  createdBy   String // User ID who performed the action
  
  // Relations
  feature     FeatureDefinition @relation(fields: [featureKey], references: [key], onDelete: Cascade)
  tenant      Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([featureKey])
  @@index([scope])
  @@index([tenantId])
  @@index([createdAt])
  @@index([createdBy])
}

model SetupState {
  id              String @id @default("singleton") // Singleton record
  isCompleted     Boolean @default(false)
  currentStep     String? // Current wizard step if in progress
  contextSnapshot String? // JSON snapshot of wizard context
  completedAt     DateTime?
  completedBy     String? // User ID who completed setup
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([isCompleted])
  @@index([completedAt])
}
