generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  tenantId     String?
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model User {
  id                     String                  @id @default(cuid())
  name                   String?
  email                  String?                 @unique
  emailVerified          DateTime?
  image                  String?
  hashedPassword         String?
  isEmailVerified        Boolean                 @default(false)
  emailVerificationToken String?                 @unique
  passwordResetToken     String?                 @unique
  passwordResetExpires   DateTime?
  platformRole           String?
  status                 String                  @default("active")
  lastLoginAt            DateTime?
  twoFactorSecret        String?
  twoFactorEnabled       Boolean                 @default(false)
  
  // Profile fields
  bio                    String?
  location               String?
  website                String?
  timezone               String                  @default("UTC")
  locale                 String                  @default("en")
  
  // Notification preferences
  emailNotifications     Boolean                 @default(true)
  marketingEmails        Boolean                 @default(false)
  securityAlerts         Boolean                 @default(true)
  activityUpdates        Boolean                 @default(false)
  
  // Support notification preferences  
  notifySupportRepliesUI    Boolean                 @default(true)
  notifySupportRepliesEmail Boolean                 @default(true)
  
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  accounts               Account[]
  auditLogs              AuditLog[]
  authenticatorCodes     AuthenticatorCode[]
  contactMessages        ContactMessage[]
  sentInvitations        Invitation[]            @relation("InvitedBy")
  acceptedInvitations    Invitation[]            @relation("InvitationAcceptedBy")
  memberships            Membership[]
  invitedMemberships     Membership[]            @relation("InvitedBy")
  notifications          Notification[]
  notificationRecipients NotificationRecipient[]
  passkeys               Passkey[]
  sessions               Session[]
  twoFactorMethods       TwoFactorMethod[]
  
  // Support system relations
  assignedCases          SupportCase[]           @relation("CaseAssignee") 
  caseStatusChanges      CaseStatusHistory[]     @relation("StatusChangedBy")
  caseMetrics            CaseMetrics[]           @relation("CaseMetricsAssignee")
  pendingAuths           PendingAuth[]
  twoFactorCodes         TwoFactorCode[]
  twoFactorAudits        TwoFactorAudit[]
  ssoAuditLogs           SsoAuditLog[]

  @@index([email])
  @@index([platformRole])
  @@index([status])
  @@index([lastLoginAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Tenant {
  id                             String            @id @default(cuid())
  slug                           String            @unique
  name                           String
  status                         String            @default("active")
  subdomain                      String?           @unique
  customDomain                   String?           @unique
  domainAlias                    String?           @unique // Custom domain alias for tenancy access
  registrationClosed             Boolean           @default(false) // Whether registration is closed for this tenancy
  logoUrl                        String?
  theme                          String?
  primaryColor                   String?
  secondaryColor                 String?
  invitePolicy                   String            @default("admin_only")
  emailVerificationBypassEnabled Boolean           @default(false)
  locale                         String            @default("en")
  timezone                       String            @default("UTC")
  plan                           String            @default("free")
  limits                         String?
  featureFlags                   String?
  ssoEnabled                     Boolean           @default(false)
  ssoProvider                    String?
  billingEnabled                 Boolean           @default(false)
  stripeCustomerId               String?
  currentPeriodStart             DateTime?
  currentPeriodEnd               DateTime?
  cancelAtPeriodEnd              Boolean           @default(false)
  description                    String?
  website                        String?
  industry                       String?
  size                           String?
  contactEmail                   String?           // Contact email for support and business inquiries
  createdAt                      DateTime          @default(now())
  updatedAt                      DateTime          @updatedAt
  suspendedAt                    DateTime?
  deletedAt                      DateTime?
  auditLogs                      AuditLog[]
  contactMessages                ContactMessage[]
  contactReasons                 ContactReason[]
  invitations                    Invitation[]
  memberships                    Membership[]
  notifications                  Notification[]
  sessions                       Session[]
  webhookEndpoints               WebhookEndpoint[]
  featureRules                   TenantFeatureRule[]
  featureAuditEntries           FeatureAuditEntry[]
  twoFactorMethods               TwoFactorMethod[]
  pendingAuths                   PendingAuth[]
  twoFactorCodes                 TwoFactorCode[]
  twoFactorAudits                TwoFactorAudit[]
  
  // Support system relations
  supportOptions                 SupportOption[]
  supportCases                   SupportCase[]
  caseMetrics                    CaseMetrics[]
  supportConfigurations          SupportConfiguration[]
  supportRouting                 TenantSupportRouting[]
  
  // SSO configuration
  ssoConfiguration               TenantSsoConfiguration?
  ssoAuditLogs                   SsoAuditLog[]

  @@index([slug])
  @@index([subdomain])
  @@index([domainAlias])
  @@index([status])
  @@index([plan])
  @@index([createdAt])
  @@index([suspendedAt])
  @@index([deletedAt])
}

model TenantSsoConfiguration {
  id                    String   @id @default(cuid())
  tenantId              String   @unique
  
  // Basic SSO configuration
  provider              String   // "saml", "oidc", "azure-ad", "google-workspace", "okta", "auth0", etc.
  providerName          String   // Display name for the provider
  isEnabled             Boolean  @default(false)
  enforceSSO            Boolean  @default(false) // If true, disable password login for this tenant
  
  // SAML Configuration
  samlEntityId          String?  // SAML Entity ID
  samlSsoUrl            String?  // SAML SSO URL
  samlSloUrl            String?  // SAML SLO URL (optional)
  samlCertificate       String?  // X.509 Certificate (PEM format)
  samlSigningCert       String?  // Signing certificate if different
  samlNameIdFormat      String?  // Name ID format
  samlAttributeMapping  Json?    // Attribute mappings for user data
  
  // OIDC Configuration
  oidcIssuer            String?  // OIDC Issuer URL
  oidcClientId          String?  // OIDC Client ID
  oidcClientSecret      String?  // OIDC Client Secret (encrypted)
  oidcScopes            String?  // Space-separated scopes
  oidcTokenEndpoint     String?  // Token endpoint URL
  oidcAuthEndpoint      String?  // Authorization endpoint URL
  oidcUserinfoEndpoint  String?  // Userinfo endpoint URL
  oidcJwksUri           String?  // JWKS URI for token verification
  
  // Generic OAuth2 Configuration (for providers like Azure AD)
  oauth2ClientId        String?
  oauth2ClientSecret    String?  // Encrypted
  oauth2AuthUrl         String?
  oauth2TokenUrl        String?
  oauth2UserInfoUrl     String?
  oauth2Scopes          String?
  
  // User provisioning settings
  autoProvisionUsers    Boolean  @default(true)   // Auto-create users on first SSO login
  defaultRole           String   @default("member") // Default role for new SSO users
  allowedDomains        String?  // Comma-separated list of allowed email domains
  userAttributeMapping  Json?    // Mapping of SSO attributes to user fields
  
  // Security settings
  signAssertions        Boolean  @default(true)   // Require signed SAML assertions
  signRequests          Boolean  @default(false)  // Sign SAML requests
  encryptAssertions     Boolean  @default(false)  // Encrypt SAML assertions
  sessionTimeout        Int?     @default(480)    // Session timeout in minutes
  
  // Audit and metadata
  lastSyncAt            DateTime?
  lastLoginAt           DateTime?
  totalLogins           Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  createdBy             String   // User ID who configured SSO
  updatedBy             String   // User ID who last updated SSO
  
  // Relations
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
  @@index([provider])
  @@index([isEnabled])
}

model SsoAuditLog {
  id                String   @id @default(cuid())
  tenantId          String
  userId            String?  // User involved in the SSO event (if applicable)
  event             String   // "login_attempt", "login_success", "login_failure", "config_updated", etc.
  provider          String   // SSO provider used
  ipAddress         String?
  userAgent         String?
  samlRequestId     String?  // SAML request ID for correlation
  samlResponseId    String?  // SAML response ID for correlation
  errorMessage      String?  // Error details for failed attempts
  attributes        Json?    // Additional attributes from SSO response
  sessionId         String?  // Session ID created
  createdAt         DateTime @default(now())
  
  // Relations
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
  @@index([userId])
  @@index([event])
  @@index([provider])
  @@index([createdAt])
}

model Membership {
  id                   String    @id @default(cuid())
  tenantId             String
  userId               String
  role                 String
  status               String    @default("active")
  permissions          String?
  invitedByUserId      String?
  invitationAcceptedAt DateTime?
  lastActiveAt         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy            User?     @relation("InvitedBy", fields: [invitedByUserId], references: [id])

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@index([role])
  @@index([status])
  @@index([lastActiveAt])
}

model Invitation {
  id                      String    @id @default(cuid())
  tenantId                String
  email                   String
  role                    String
  token                   String    @unique
  expiresAt               DateTime
  bypassEmailVerification Boolean   @default(false)
  status                  String    @default("pending")
  message                 String?
  acceptedAt              DateTime?
  acceptedByUserId        String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  invitedByUserId         String
  tenant                  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy               User      @relation("InvitedBy", fields: [invitedByUserId], references: [id])
  acceptedBy              User?     @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id])

  @@index([tenantId])
  @@index([email])
  @@index([token])
  @@index([status])
  @@index([expiresAt])
  @@index([createdAt])
}

model ContactReason {
  id              String                 @id @default(cuid())
  key             String                 @unique
  label           String
  description     String
  icon            String
  helpType        String                 @default("general") // technical, billing, account, general
  isActive        Boolean                @default(true)
  sortOrder       Int                    @default(0)
  tenantId        String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  contactMessages ContactMessageReason[]
  tenant          Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([isActive])
  @@index([sortOrder])
  @@index([helpType])
}

model ContactMessage {
  id         String                 @id @default(cuid())
  name       String
  email      String
  subject    String
  message    String
  userId     String?
  tenantId   String?
  status     String                 @default("open")
  priority   String                 @default("normal")
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  assignedTo String?
  category   String?
  dueDate    DateTime?
  resolvedAt DateTime?
  tags       String?
  user       User?                  @relation(fields: [userId], references: [id])
  tenant     Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reasons    ContactMessageReason[]
  replies    ContactReply[]
  supportCase SupportCase? // One-to-one relation to support case

  @@index([userId])
  @@index([tenantId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([assignedTo])
  @@index([createdAt])
  @@index([resolvedAt])
}

model ContactMessageReason {
  id               String         @id @default(cuid())
  contactMessageId String
  contactReasonId  String
  createdAt        DateTime       @default(now())
  contactMessage   ContactMessage @relation(fields: [contactMessageId], references: [id], onDelete: Cascade)
  contactReason    ContactReason  @relation(fields: [contactReasonId], references: [id], onDelete: Cascade)

  @@unique([contactMessageId, contactReasonId])
  @@index([contactMessageId])
  @@index([contactReasonId])
}

model ContactReply {
  id               String         @id @default(cuid())
  contactMessageId String
  message          String
  isFromUser       Boolean        @default(false)
  isInternal       Boolean        @default(false)
  attachments      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  contactMessage   ContactMessage @relation(fields: [contactMessageId], references: [id], onDelete: Cascade)
  caseMessages     CaseMessage[]

  @@index([contactMessageId])
  @@index([isFromUser])
  @@index([isInternal])
  @@index([createdAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  tenantId     String?
  userId       String
  action       String
  resourceType String?
  resourceId   String?
  details      String?
  ipAddress    String?
  userAgent    String?
  metadata     String?
  severity     String   @default("info")
  traceId      String?  // Distributed tracing ID
  createdAt    DateTime @default(now())
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([resourceType])
  @@index([severity])
  @@index([traceId])
  @@index([createdAt])
}

model Passkey {
  id               String    @id @default(cuid())
  userId           String
  name             String
  credentialId     String    @unique
  publicKey        String
  signCount        Int       @default(0)
  transports       String?
  backupEligible   Boolean   @default(false)
  backupState      Boolean   @default(false)
  userVerification String    @default("preferred")
  rpId             String?   // Relying Party ID (domain) this passkey was registered for
  isActive         Boolean   @default(true)
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([credentialId])
  @@index([isActive])
  @@index([lastUsedAt])
  @@index([createdAt])
  @@index([rpId])
}

model AuthenticatorCode {
  id         String    @id @default(cuid())
  userId     String
  name       String
  secret     String
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@index([createdAt])
}

model Notification {
  id          String                  @id @default(cuid())
  title       String
  description String?
  type        String                  @default("info")
  priority    String                  @default("normal")
  status      String                  @default("unread")
  tenantId    String?
  role        String?
  userId      String?
  metadata    String?
  expiresAt   DateTime?
  readAt      DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  user        User?                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipients  NotificationRecipient[]

  @@index([tenantId])
  @@index([role])
  @@index([userId])
  @@index([type])
  @@index([priority])
  @@index([status])
  @@index([expiresAt])
  @@index([createdAt])
}

model NotificationRecipient {
  id             String       @id @default(cuid())
  notificationId String
  userId         String
  status         String       @default("unread")
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([notificationId])
  @@index([userId])
  @@index([status])
  @@index([readAt])
  @@index([createdAt])
}

model WebhookEndpoint {
  id              String    @id @default(cuid())
  tenantId        String?
  name            String
  url             String
  secret          String?
  events          String
  isActive        Boolean   @default(true)
  lastTriggeredAt DateTime?
  failureCount    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tenant          Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([isActive])
  @@index([lastTriggeredAt])
  @@index([createdAt])
}

// Feature Toggle System Models

model FeatureDefinition {
  id          String @id @default(cuid())
  key         String @unique // e.g., "notifications", "sso", "discussion_wall"
  name        String // Human-readable name
  description String? // Description of the feature
  tier        String // "Core", "Secondary", "Tenancy-only"
  defaultEnabled Boolean @default(false) // Default state for new tenants
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String // User ID who created this feature
  
  // Relations
  globalRules GlobalFeatureRule[]
  tenantRules TenantFeatureRule[]
  auditEntries FeatureAuditEntry[]
  
  @@index([tier])
  @@index([defaultEnabled])
  @@index([createdAt])
}

model GlobalFeatureRule {
  id        String @id @default(cuid())
  featureKey String // References FeatureDefinition.key
  enabled   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String // User ID who created/modified this rule
  
  // Relations
  feature   FeatureDefinition @relation(fields: [featureKey], references: [key], onDelete: Cascade)
  
  @@unique([featureKey]) // Only one global rule per feature
  @@index([enabled])
  @@index([createdAt])
}

model TenantFeatureRule {
  id        String @id @default(cuid())
  tenantId  String
  featureKey String // References FeatureDefinition.key
  enabled   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String // User ID who created/modified this rule
  
  // Relations
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feature   FeatureDefinition @relation(fields: [featureKey], references: [key], onDelete: Cascade)
  
  @@unique([tenantId, featureKey]) // Only one rule per tenant per feature
  @@index([tenantId])
  @@index([enabled])
  @@index([createdAt])
}

model FeatureAuditEntry {
  id          String @id @default(cuid())
  featureKey  String // References FeatureDefinition.key
  scope       String // "global" or "tenant"
  tenantId    String? // Null for global scope
  beforeValue String? // JSON representation of previous state
  afterValue  String? // JSON representation of new state
  action      String // "create", "update", "delete", "enable", "disable"
  createdAt   DateTime @default(now())
  createdBy   String // User ID who performed the action
  
  // Relations
  feature     FeatureDefinition @relation(fields: [featureKey], references: [key], onDelete: Cascade)
  tenant      Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([featureKey])
  @@index([scope])
  @@index([tenantId])
  @@index([createdAt])
  @@index([createdBy])
}

model SetupState {
  id              String @id @default("singleton") // Singleton record
  isCompleted     Boolean @default(false)
  currentStep     String? // Current wizard step if in progress
  contextSnapshot String? // JSON snapshot of wizard context
  completedAt     DateTime?
  completedBy     String? // User ID who completed setup
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([isCompleted])
  @@index([completedAt])
}

// 2FA Factor model - tracks enabled 2FA methods per user
model TwoFactorMethod {
  id           String   @id @default(cuid())
  userId       String
  tenantId     String?
  type         String   // 'totp', 'whatsapp', 'sms', 'email'
  identifier   String?  // phone number for whatsapp/sms, email for email
  secret       String?  // TOTP secret or encrypted data
  isVerified   Boolean  @default(false)
  isEnabled    Boolean  @default(false)
  backupCodes  String?  // JSON array of backup codes
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastUsedAt   DateTime?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, type, tenantId])
  @@index([userId])
  @@index([type])
  @@index([tenantId])
}

// Pending 2FA authentication state
model PendingAuth {
  id             String   @id @default(cuid())
  userId         String
  tenantId       String?
  nonce          String   @unique
  requiredFactors String  // JSON array of required factor types
  createdAt      DateTime @default(now())
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([nonce])
  @@index([expiresAt])
  @@index([tenantId])
}

// 2FA verification codes (OTP for WhatsApp, SMS, etc.)
model TwoFactorCode {
  id          String   @id @default(cuid())
  userId      String
  tenantId    String?
  type        String   // 'whatsapp', 'sms', 'email'
  codeHash    String   // hashed verification code
  salt        String   // salt for the hash
  purpose     String   // 'login_2fa', 'factor_activation'
  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  usedAt      DateTime?
  traceId     String?  // for tracking webhook delivery

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([purpose])
  @@index([expiresAt])
  @@index([tenantId])
  @@index([traceId])
}

// 2FA audit log
model TwoFactorAudit {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String?
  action    String   // 'enable', 'disable', 'send', 'verify', 'fail', 'lockout'
  factorType String  // 'totp', 'whatsapp', 'sms', 'email'
  success   Boolean
  ipAddress String?
  userAgent String?
  metadata  String?  // JSON for additional context
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([factorType])
  @@index([createdAt])
  @@index([tenantId])
}

// ==========================================
// SUPPORT RESOLUTION CENTER MODELS
// ==========================================

// Support Cases - Resolution lifecycle management for support interactions
model SupportCase {
  id                String                 @id @default(cuid())
  contactMessageId  String?                @unique // Link to existing ContactMessage
  caseNumberSeq     BigInt                 @unique @default(autoincrement()) // Auto-incrementing sequence number (starts at 1M)
  caseNumber        String?                @unique // Base32 encoded case number (auto-generated)
  title             String                 // Case title
  description       String?                // Extended case description
  status            String                 @default("OPEN") // OPEN, PENDING, RESOLVED, CLOSED
  priority          String                 @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  assigneeId        String?                // Optional assignee
  tenantId          String?                // Tenant context
  supportOptionId   String?                // Support option used
  threadingKey      String?                @unique // Stable key for threading messages
  source            String                 @default("CONTACT_FORM") // CONTACT_FORM, EMAIL, SMS, WHATSAPP, WEBHOOK
  sourceMetadata    Json?                  // Provider-specific metadata
  firstResponseAt   DateTime?
  resolvedAt        DateTime?
  closedAt          DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  
  // Relations
  contactMessage    ContactMessage?        @relation(fields: [contactMessageId], references: [id], onDelete: SetNull)
  assignee          User?                  @relation("CaseAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  tenant            Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supportOption     SupportOption?         @relation(fields: [supportOptionId], references: [id], onDelete: SetNull)
  messages          CaseMessage[]
  statusHistory     CaseStatusHistory[]
  
  @@index([status])
  @@index([assigneeId])
  @@index([tenantId])
  @@index([threadingKey])
  @@index([createdAt])
  @@index([source])
  @@index([priority])
}

// Support Options - Routing configuration for support requests
model SupportOption {
  id               String            @id @default(cuid())
  key              String            // Unique key (e.g., 'billing', 'technical')
  label            String            // Display name
  description      String?           // Help text
  icon             String?           // Icon name/class
  isActive         Boolean           @default(true)
  isGlobal         Boolean           @default(true) // Platform vs tenant option
  tenantId         String?           // NULL for global options
  parentOptionId   String?           // For tenant overrides
  sortOrder        Int               @default(0)
  isHidden         Boolean           @default(false) // Hidden but available for routing
  routingConfig    Json              // Routing configuration (emails, webhooks, etc.)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  
  // Relations
  tenant           Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent           SupportOption?    @relation("OptionHierarchy", fields: [parentOptionId], references: [id], onDelete: SetNull)
  children         SupportOption[]   @relation("OptionHierarchy")
  cases            SupportCase[]
  metrics          CaseMetrics[]
  
  @@unique([key], name: "global_key")
  @@unique([tenantId, key], name: "tenant_key")
  @@index([tenantId])
  @@index([isActive])
  @@index([parentOptionId])
  @@index([sortOrder])
}

// Case Messages - Unified thread for case communications
model CaseMessage {
  id                String           @id @default(cuid())
  caseId            String
  contactReplyId    String?          // Link to existing ContactReply if applicable
  direction         String           // INBOUND, OUTBOUND
  channel           String           // EMAIL, SMS, WHATSAPP, UI, SYSTEM
  fromAddress       String?          // Email, phone number, user ID, etc.
  toAddress         String?
  subject           String?          // For email messages
  content           String
  isInternal        Boolean          @default(false) // Internal notes vs customer-visible
  messageId         String?          // Provider message ID for deduplication
  threadingData     Json?            // Headers, references for threading
  attachments       Json?            // Array of attachment metadata
  deliveryStatus    String?          @default("PENDING") // PENDING, SENT, DELIVERED, FAILED
  deliveryMetadata  Json?            // Provider delivery receipts/errors
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  
  // Relations
  case              SupportCase      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  contactReply      ContactReply?    @relation(fields: [contactReplyId], references: [id], onDelete: SetNull)
  
  @@index([caseId])
  @@index([createdAt])
  @@index([direction])
  @@index([messageId]) // For deduplication
  @@index([channel])
  @@index([deliveryStatus])
}

// Case Status History - Audit trail for status changes
model CaseStatusHistory {
  id           String      @id @default(cuid())
  caseId       String
  fromStatus   String?
  toStatus     String
  changedBy    String?     // User who changed the status
  reason       String?     // Optional reason for change
  metadata     Json?       // Additional context
  createdAt    DateTime    @default(now())
  
  // Relations
  case         SupportCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user         User?       @relation("StatusChangedBy", fields: [changedBy], references: [id], onDelete: SetNull)
  
  @@index([caseId])
  @@index([createdAt])
  @@index([toStatus])
}

// Case Metrics - Pre-aggregated metrics for analytics
model CaseMetrics {
  id                    String         @id @default(cuid())
  tenantId              String?
  date                  DateTime       @db.Date // Daily aggregation
  supportOptionId       String?
  assigneeId            String?
  totalCases            Int            @default(0)
  openCases             Int            @default(0)
  pendingCases          Int            @default(0)
  resolvedCases         Int            @default(0)
  closedCases           Int            @default(0)
  avgFirstResponseTime  Int?           // in minutes
  avgResolutionTime     Int?           // in minutes
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  
  // Relations
  tenant                Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supportOption         SupportOption? @relation(fields: [supportOptionId], references: [id], onDelete: SetNull)
  assignee              User?          @relation("CaseMetricsAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  
  @@unique([tenantId, date, supportOptionId, assigneeId])
  @@index([date])
  @@index([tenantId])
}

// Support Configuration - System and tenant policies  
model SupportConfiguration {
  id           String    @id @default(cuid())
  tenantId     String?   // NULL for global config
  key          String
  value        Json
  description  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  // Relations
  tenant       Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@unique([key], name: "global_config_key")
  @@unique([tenantId, key], name: "tenant_config_key")
  @@index([tenantId])
}

// Tenant-specific email routing per help type
model TenantSupportRouting {
  id         String    @id @default(cuid())
  tenantId   String
  helpType   String    // technical, billing, account, general
  email      String
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  
  // Relations
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@unique([tenantId, helpType])
  @@index([tenantId])
  @@index([helpType])
  @@index([isActive])
}

// Outbox events to be dispatched to the queue/bus
model OutboxEvent {
  id              BigInt    @id @default(autoincrement())
  eventType       String    // e.g. 'support.case.created'
  aggregateType   String    // e.g. 'support_case'
  aggregateId     String
  tenantId        String
  payloadJson     Json
  idempotencyKey  String?   @unique // hash or external id if available
  status          String    @default("pending") // pending|processing|sent|failed|dead
  tries           Int       @default(0)
  nextAttemptAt   DateTime  @default(now())
  createdAt       DateTime  @default(now())
  lastError       String?
  traceId         String?   // Distributed tracing ID

  @@index([status, nextAttemptAt])
  @@index([tenantId])
  @@index([eventType])
  @@index([traceId])
}

// Audit events for compliance and monitoring
model AuditEvent {
  id              String    @id // Generated hash from original event
  eventType       String    // Normalized audit category: auth, financial, support, etc.
  eventName       String    // Original event type name
  tenantId        String
  userId          String?   // User associated with the event
  aggregateType   String    // Original aggregate type
  aggregateId     String    // Original aggregate ID
  timestamp       DateTime  // When the original event occurred
  
  // Source information
  sourceService   String    // Service that generated the event
  sourceVersion   String?   // Version of the service
  sourceHost      String?   // Host/instance identifier
  requestId       String?   // Request correlation ID
  correlationId   String?   // Business correlation ID
  traceId         String?   // Distributed tracing ID
  
  // Actor information (who performed the action)
  actorType       String?   // user, system, service
  actorId         String?   // Actor identifier
  actorName       String?   // Actor display name
  actorEmail      String?   // Actor email (hashed for privacy)
  actorIpAddress  String?   // Source IP address
  actorUserAgent  String?   // User agent string
  
  // Resource information (what was affected)
  resourceType    String?   // Type of resource
  resourceId      String?   // Resource identifier
  resourceName    String?   // Resource display name
  resourceAttributes String? @db.Text // JSON string of resource attributes
  
  // Action information (what happened)
  actionType      String    // Type of action performed
  actionDescription String? // Human-readable description
  actionOutcome   String    // success, failure, unknown
  actionReason    String?   // Reason for failure or additional context
  
  // Metadata and payload
  metadata        String?   @db.Text // JSON string of additional metadata
  originalPayload String    @db.Text // JSON string of original event payload
  
  // Timestamps
  createdAt       DateTime  @default(now()) // When audit record was created
  
  @@index([tenantId, timestamp])
  @@index([eventType, timestamp])
  @@index([userId, timestamp])
  @@index([actorId, timestamp])
  @@index([resourceType, resourceId])
  @@index([actionOutcome, timestamp])
  @@index([traceId])
  @@index([createdAt])
}
