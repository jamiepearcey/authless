generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  tenantId     String?
  expires      DateTime
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model User {
  id                        String                  @id @default(cuid())
  name                      String?
  email                     String?                 @unique
  emailVerified             DateTime?
  image                     String?
  hashedPassword            String?
  isEmailVerified           Boolean                 @default(false)
  emailVerificationToken    String?                 @unique
  passwordResetToken        String?                 @unique
  passwordResetExpires      DateTime?
  platformRole              String?
  status                    String                  @default("active")
  lastLoginAt               DateTime?
  twoFactorSecret           String?
  twoFactorEnabled          Boolean                 @default(false)
  bio                       String?
  location                  String?
  website                   String?
  timezone                  String                  @default("UTC")
  locale                    String                  @default("en")
  emailNotifications        Boolean                 @default(true)
  marketingEmails           Boolean                 @default(false)
  securityAlerts            Boolean                 @default(true)
  activityUpdates           Boolean                 @default(false)
  notifySupportRepliesUI    Boolean                 @default(true)
  notifySupportRepliesEmail Boolean                 @default(true)
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  accounts                  Account[]
  auditLogs                 AuditLog[]
  authenticatorCodes        AuthenticatorCode[]
  caseMetrics               CaseMetrics[]           @relation("CaseMetricsAssignee")
  caseStatusChanges         CaseStatusHistory[]     @relation("StatusChangedBy")
  contactMessages           ContactMessage[]
  acceptedInvitations       Invitation[]            @relation("InvitationAcceptedBy")
  sentInvitations           Invitation[]            @relation("InvitedBy")
  invitedMemberships        Membership[]            @relation("InvitedBy")
  memberships               Membership[]
  notifications             Notification[]
  notificationRecipients    NotificationRecipient[]
  passkeys                  Passkey[]
  pendingAuths              PendingAuth[]
  sessions                  Session[]
  ssoAuditLogs              SsoAuditLog[]
  assignedCases             SupportCase[]           @relation("CaseAssignee")
  twoFactorAudits           TwoFactorAudit[]
  twoFactorCodes            TwoFactorCode[]
  twoFactorMethods          TwoFactorMethod[]
  createdEmailProviders     EmailProvider[]

  @@index([email])
  @@index([platformRole])
  @@index([status])
  @@index([lastLoginAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Tenant {
  id                             String                  @id @default(cuid())
  slug                           String                  @unique
  name                           String
  status                         String                  @default("active")
  subdomain                      String?                 @unique
  customDomain                   String?                 @unique
  logoUrl                        String?
  theme                          String?
  primaryColor                   String?
  secondaryColor                 String?
  invitePolicy                   String                  @default("admin_only")
  emailVerificationBypassEnabled Boolean                 @default(false)
  locale                         String                  @default("en")
  timezone                       String                  @default("UTC")
  plan                           String                  @default("free")
  limits                         String?
  featureFlags                   String?
  ssoEnabled                     Boolean                 @default(false)
  ssoProvider                    String?
  billingEnabled                 Boolean                 @default(false)
  stripeCustomerId               String?
  currentPeriodStart             DateTime?
  currentPeriodEnd               DateTime?
  cancelAtPeriodEnd              Boolean                 @default(false)
  description                    String?
  website                        String?
  industry                       String?
  size                           String?
  contactEmail                   String?
  createdAt                      DateTime                @default(now())
  updatedAt                      DateTime                @updatedAt
  suspendedAt                    DateTime?
  deletedAt                      DateTime?
  domainAlias                    String?                 @unique
  registrationClosed             Boolean                 @default(false)
  auditLogs                      AuditLog[]
  caseMetrics                    CaseMetrics[]
  contactMessages                ContactMessage[]
  contactReasons                 ContactReason[]
  featureAuditEntries            FeatureAuditEntry[]
  invitations                    Invitation[]
  memberships                    Membership[]
  notifications                  Notification[]
  pendingAuths                   PendingAuth[]
  sessions                       Session[]
  ssoAuditLogs                   SsoAuditLog[]
  supportCases                   SupportCase[]
  supportConfigurations          SupportConfiguration[]
  supportOptions                 SupportOption[]
  featureRules                   TenantFeatureRule[]
  ssoConfiguration               TenantSsoConfiguration?
  supportRouting                 TenantSupportRouting[]
  twoFactorAudits                TwoFactorAudit[]
  twoFactorCodes                 TwoFactorCode[]
  twoFactorMethods               TwoFactorMethod[]
  webhookEndpoints               WebhookEndpoint[]

  @@index([slug])
  @@index([subdomain])
  @@index([status])
  @@index([plan])
  @@index([createdAt])
  @@index([suspendedAt])
  @@index([deletedAt])
}

model TenantSsoConfiguration {
  id                   String    @id @default(cuid())
  tenantId             String    @unique
  provider             String
  providerName         String
  isEnabled            Boolean   @default(false)
  enforceSSO           Boolean   @default(false)
  samlEntityId         String?
  samlSsoUrl           String?
  samlSloUrl           String?
  samlCertificate      String?
  samlSigningCert      String?
  samlNameIdFormat     String?
  samlAttributeMapping Json?
  oidcIssuer           String?
  oidcClientId         String?
  oidcClientSecret     String?
  oidcScopes           String?
  oidcTokenEndpoint    String?
  oidcAuthEndpoint     String?
  oidcUserinfoEndpoint String?
  oidcJwksUri          String?
  oauth2ClientId       String?
  oauth2ClientSecret   String?
  oauth2AuthUrl        String?
  oauth2TokenUrl       String?
  oauth2UserInfoUrl    String?
  oauth2Scopes         String?
  autoProvisionUsers   Boolean   @default(true)
  defaultRole          String    @default("member")
  allowedDomains       String?
  userAttributeMapping Json?
  signAssertions       Boolean   @default(true)
  signRequests         Boolean   @default(false)
  encryptAssertions    Boolean   @default(false)
  sessionTimeout       Int?      @default(480)
  lastSyncAt           DateTime?
  lastLoginAt          DateTime?
  totalLogins          Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  createdBy            String
  updatedBy            String
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([provider])
  @@index([isEnabled])
}

model SsoAuditLog {
  id             String   @id @default(cuid())
  tenantId       String
  userId         String?
  event          String
  provider       String
  ipAddress      String?
  userAgent      String?
  samlRequestId  String?
  samlResponseId String?
  errorMessage   String?
  attributes     Json?
  sessionId      String?
  createdAt      DateTime @default(now())
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([event])
  @@index([provider])
  @@index([createdAt])
}

model Membership {
  id                   String    @id @default(cuid())
  tenantId             String
  userId               String
  role                 String
  status               String    @default("active")
  permissions          String?
  invitedByUserId      String?
  invitationAcceptedAt DateTime?
  lastActiveAt         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  invitedBy            User?     @relation("InvitedBy", fields: [invitedByUserId], references: [id])
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@index([role])
  @@index([status])
  @@index([lastActiveAt])
}

model Invitation {
  id                      String    @id @default(cuid())
  tenantId                String
  email                   String
  role                    String
  token                   String    @unique
  expiresAt               DateTime
  bypassEmailVerification Boolean   @default(false)
  status                  String    @default("pending")
  message                 String?
  acceptedAt              DateTime?
  acceptedByUserId        String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  invitedByUserId         String
  acceptedBy              User?     @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id])
  invitedBy               User      @relation("InvitedBy", fields: [invitedByUserId], references: [id])
  tenant                  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([email])
  @@index([token])
  @@index([status])
  @@index([expiresAt])
  @@index([createdAt])
}

model ContactReason {
  id              String                 @id @default(cuid())
  key             String                 @unique
  label           String
  description     String
  icon            String
  helpType        String                 @default("general")
  isActive        Boolean                @default(true)
  sortOrder       Int                    @default(0)
  tenantId        String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  contactMessages ContactMessageReason[]
  tenant          Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([isActive])
  @@index([sortOrder])
  @@index([helpType])
}

model ContactMessage {
  id          String                 @id @default(cuid())
  name        String
  email       String
  subject     String
  message     String
  userId      String?
  tenantId    String?
  status      String                 @default("open")
  priority    String                 @default("normal")
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  assignedTo  String?
  category    String?
  dueDate     DateTime?
  resolvedAt  DateTime?
  tags        String?
  tenant      Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User?                  @relation(fields: [userId], references: [id])
  reasons     ContactMessageReason[]
  replies     ContactReply[]
  supportCase SupportCase?

  @@index([userId])
  @@index([tenantId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([assignedTo])
  @@index([createdAt])
  @@index([resolvedAt])
}

model ContactMessageReason {
  id               String         @id @default(cuid())
  contactMessageId String
  contactReasonId  String
  createdAt        DateTime       @default(now())
  contactMessage   ContactMessage @relation(fields: [contactMessageId], references: [id], onDelete: Cascade)
  contactReason    ContactReason  @relation(fields: [contactReasonId], references: [id], onDelete: Cascade)

  @@unique([contactMessageId, contactReasonId])
  @@index([contactMessageId])
  @@index([contactReasonId])
}

model ContactReply {
  id               String         @id @default(cuid())
  contactMessageId String
  message          String
  isFromUser       Boolean        @default(false)
  isInternal       Boolean        @default(false)
  attachments      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  caseMessages     CaseMessage[]
  contactMessage   ContactMessage @relation(fields: [contactMessageId], references: [id], onDelete: Cascade)

  @@index([contactMessageId])
  @@index([isFromUser])
  @@index([isInternal])
  @@index([createdAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  tenantId     String?
  userId       String?
  action       String
  resourceType String?
  resourceId   String?
  details      String?
  ipAddress    String?
  userAgent    String?
  metadata     String?
  severity     String   @default("info")
  createdAt    DateTime @default(now())
  traceId      String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([resourceType])
  @@index([severity])
  @@index([createdAt])
}

model Passkey {
  id               String    @id @default(cuid())
  userId           String
  name             String
  credentialId     String    @unique
  publicKey        String
  signCount        Int       @default(0)
  transports       String?
  backupEligible   Boolean   @default(false)
  backupState      Boolean   @default(false)
  userVerification String    @default("preferred")
  rpId             String?
  isActive         Boolean   @default(true)
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([credentialId])
  @@index([isActive])
  @@index([lastUsedAt])
  @@index([rpId])
  @@index([createdAt])
}

model AuthenticatorCode {
  id         String    @id @default(cuid())
  userId     String
  name       String
  secret     String
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@index([createdAt])
}

model Notification {
  id          String                  @id @default(cuid())
  title       String
  description String?
  type        String                  @default("info")
  priority    String                  @default("normal")
  status      String                  @default("unread")
  tenantId    String?
  role        String?
  userId      String?
  metadata    String?
  expiresAt   DateTime?
  readAt      DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  tenant      Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User?                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipients  NotificationRecipient[]

  @@index([tenantId])
  @@index([role])
  @@index([userId])
  @@index([type])
  @@index([priority])
  @@index([status])
  @@index([expiresAt])
  @@index([createdAt])
}

model NotificationRecipient {
  id             String       @id @default(cuid())
  notificationId String
  userId         String
  status         String       @default("unread")
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([notificationId])
  @@index([userId])
  @@index([status])
  @@index([readAt])
  @@index([createdAt])
}

model WebhookEndpoint {
  id              String    @id @default(cuid())
  tenantId        String?
  name            String
  url             String
  secret          String?
  events          String
  isActive        Boolean   @default(true)
  lastTriggeredAt DateTime?
  failureCount    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tenant          Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([isActive])
  @@index([lastTriggeredAt])
  @@index([createdAt])
}

model FeatureDefinition {
  id             String              @id @default(cuid())
  key            String              @unique
  name           String
  description    String?
  tier           String
  defaultEnabled Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  createdBy      String
  auditEntries   FeatureAuditEntry[]
  globalRules    GlobalFeatureRule?
  tenantRules    TenantFeatureRule[]

  @@index([tier])
  @@index([defaultEnabled])
  @@index([createdAt])
}

model GlobalFeatureRule {
  id         String            @id @default(cuid())
  featureKey String            @unique
  enabled    Boolean
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  createdBy  String
  feature    FeatureDefinition @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  @@index([enabled])
  @@index([createdAt])
}

model TenantFeatureRule {
  id         String            @id @default(cuid())
  tenantId   String
  featureKey String
  enabled    Boolean
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  createdBy  String
  feature    FeatureDefinition @relation(fields: [featureKey], references: [key], onDelete: Cascade)
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, featureKey])
  @@index([tenantId])
  @@index([enabled])
  @@index([createdAt])
}

model FeatureAuditEntry {
  id          String            @id @default(cuid())
  featureKey  String
  scope       String
  tenantId    String?
  beforeValue String?
  afterValue  String?
  action      String
  createdAt   DateTime          @default(now())
  createdBy   String
  feature     FeatureDefinition @relation(fields: [featureKey], references: [key], onDelete: Cascade)
  tenant      Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([featureKey])
  @@index([scope])
  @@index([tenantId])
  @@index([createdAt])
  @@index([createdBy])
}

model SetupState {
  id              String    @id @default("singleton")
  isCompleted     Boolean   @default(false)
  currentStep     String?
  contextSnapshot String?
  completedAt     DateTime?
  completedBy     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isCompleted])
  @@index([completedAt])
}

model TwoFactorMethod {
  id          String    @id @default(cuid())
  userId      String
  tenantId    String?
  type        String
  identifier  String?
  secret      String?
  isVerified  Boolean   @default(false)
  isEnabled   Boolean   @default(false)
  backupCodes String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastUsedAt  DateTime?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, tenantId])
  @@index([userId])
  @@index([type])
  @@index([tenantId])
}

model PendingAuth {
  id              String   @id @default(cuid())
  userId          String
  tenantId        String?
  nonce           String   @unique
  requiredFactors String
  createdAt       DateTime @default(now())
  expiresAt       DateTime
  ipAddress       String?
  userAgent       String?
  tenant          Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([nonce])
  @@index([expiresAt])
  @@index([tenantId])
}

model TwoFactorCode {
  id          String    @id @default(cuid())
  userId      String
  tenantId    String?
  type        String
  codeHash    String
  salt        String
  purpose     String
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?
  traceId     String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([purpose])
  @@index([expiresAt])
  @@index([tenantId])
  @@index([traceId])
}

model TwoFactorAudit {
  id         String   @id @default(cuid())
  userId     String
  tenantId   String?
  action     String
  factorType String
  success    Boolean
  ipAddress  String?
  userAgent  String?
  metadata   String?
  createdAt  DateTime @default(now())
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([factorType])
  @@index([createdAt])
  @@index([tenantId])
}

model SupportCase {
  id               String              @id @default(cuid())
  contactMessageId String?             @unique
  caseNumberSeq    Int                 @unique @default(autoincrement())
  caseNumber       String?             @unique
  title            String
  description      String?
  status           String              @default("OPEN")
  priority         String              @default("NORMAL")
  assigneeId       String?
  tenantId         String?
  supportOptionId  String?
  threadingKey     String?             @unique
  source           String              @default("CONTACT_FORM")
  sourceMetadata   Json?
  firstResponseAt  DateTime?
  resolvedAt       DateTime?
  closedAt         DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  messages         CaseMessage[]
  statusHistory    CaseStatusHistory[]
  assignee         User?               @relation("CaseAssignee", fields: [assigneeId], references: [id])
  contactMessage   ContactMessage?     @relation(fields: [contactMessageId], references: [id])
  supportOption    SupportOption?      @relation(fields: [supportOptionId], references: [id])
  tenant           Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([assigneeId])
  @@index([tenantId])
  @@index([threadingKey])
  @@index([createdAt])
  @@index([source])
  @@index([priority])
}

model SupportOption {
  id             String          @id @default(cuid())
  key            String          @unique
  label          String
  description    String?
  icon           String?
  isActive       Boolean         @default(true)
  isGlobal       Boolean         @default(true)
  tenantId       String?
  parentOptionId String?
  sortOrder      Int             @default(0)
  isHidden       Boolean         @default(false)
  routingConfig  Json
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  metrics        CaseMetrics[]
  cases          SupportCase[]
  parent         SupportOption?  @relation("OptionHierarchy", fields: [parentOptionId], references: [id])
  children       SupportOption[] @relation("OptionHierarchy")
  tenant         Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key], name: "tenant_key")
  @@index([tenantId])
  @@index([isActive])
  @@index([parentOptionId])
  @@index([sortOrder])
}

model CaseMessage {
  id               String        @id @default(cuid())
  caseId           String
  contactReplyId   String?
  direction        String
  channel          String
  fromAddress      String?
  toAddress        String?
  subject          String?
  content          String
  isInternal       Boolean       @default(false)
  messageId        String?
  threadingData    Json?
  attachments      Json?
  deliveryStatus   String?       @default("PENDING")
  deliveryMetadata Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  case             SupportCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  contactReply     ContactReply? @relation(fields: [contactReplyId], references: [id])

  @@index([caseId])
  @@index([createdAt])
  @@index([direction])
  @@index([messageId])
  @@index([channel])
  @@index([deliveryStatus])
}

model CaseStatusHistory {
  id         String      @id @default(cuid())
  caseId     String
  fromStatus String?
  toStatus   String
  changedBy  String?
  reason     String?
  metadata   Json?
  createdAt  DateTime    @default(now())
  case       SupportCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user       User?       @relation("StatusChangedBy", fields: [changedBy], references: [id])

  @@index([caseId])
  @@index([createdAt])
  @@index([toStatus])
}

model CaseMetrics {
  id                   String         @id @default(cuid())
  tenantId             String?
  date                 DateTime       @db.Date
  supportOptionId      String?
  assigneeId           String?
  totalCases           Int            @default(0)
  openCases            Int            @default(0)
  pendingCases         Int            @default(0)
  resolvedCases        Int            @default(0)
  closedCases          Int            @default(0)
  avgFirstResponseTime Int?
  avgResolutionTime    Int?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  assignee             User?          @relation("CaseMetricsAssignee", fields: [assigneeId], references: [id])
  supportOption        SupportOption? @relation(fields: [supportOptionId], references: [id])
  tenant               Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date, supportOptionId, assigneeId])
  @@index([date])
  @@index([tenantId])
}

model SupportConfiguration {
  id          String   @id @default(cuid())
  tenantId    String?
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key], name: "tenant_config_key")
  @@index([tenantId])
}

model TenantSupportRouting {
  id        String   @id @default(cuid())
  tenantId  String
  helpType  String
  email     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, helpType])
  @@index([tenantId])
  @@index([helpType])
  @@index([isActive])
}

model OutboxEvent {
  id             Int      @id @default(autoincrement())
  eventType      String
  aggregateType  String
  aggregateId    String
  tenantId       String
  payloadJson    Json
  idempotencyKey String?  @unique
  status         String   @default("pending")
  tries          Int      @default(0)
  nextAttemptAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastError      String?
  traceId        String?

  @@index([status, nextAttemptAt])
  @@index([tenantId])
  @@index([eventType])
  @@index([traceId])
}

model EmailProvider {
  id        String  @id @default(cuid())
  type      String // 'mailgun', 'sendgrid', 'smtp', 'jetstream'
  enabled   Boolean @default(false)
  isDefault Boolean @default(false)

  // Common fields
  fromName     String?
  fromEmail    String?
  replyToEmail String?

  // Provider specific configuration (JSON)
  config Json // Encrypted sensitive data

  // Connection status
  isConnected    Boolean   @default(false)
  lastTested     DateTime?
  lastTestResult String?

  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  // Relations
  createdBy User? @relation(fields: [createdById], references: [id])

  @@unique([type])
  @@index([type])
  @@index([enabled])
  @@index([isDefault])
}

model AuditEvent {
  id                 String   @id
  eventType          String
  eventName          String
  tenantId           String
  userId             String?
  aggregateType      String
  aggregateId        String
  timestamp          DateTime
  sourceService      String
  sourceVersion      String?
  sourceHost         String?
  requestId          String?
  correlationId      String?
  actorType          String?
  actorId            String?
  actorName          String?
  actorEmail         String?
  actorIpAddress     String?
  actorUserAgent     String?
  resourceType       String?
  resourceId         String?
  resourceName       String?
  resourceAttributes String?
  actionType         String
  actionDescription  String?
  actionOutcome      String
  actionReason       String?
  metadata           String?
  originalPayload    String
  createdAt          DateTime @default(now())
  traceId            String?

  @@index([tenantId, timestamp])
  @@index([eventType, timestamp])
  @@index([userId, timestamp])
  @@index([actorId, timestamp])
  @@index([resourceType, resourceId])
  @@index([actionOutcome, timestamp])
  @@index([createdAt])
}

model InboxEvent {
  id             Int      @id @default(autoincrement())
  eventType      String
  aggregateType  String
  aggregateId    String
  tenantId       String?
  payloadJson    Json
  idempotencyKey String?  @unique
  status         String   @default("received")
  tries          Int      @default(0)
  nextAttemptAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  lastError      String?
  traceId        String?
  source         String?
  sourceId       String?

  @@index([status, nextAttemptAt])
  @@index([tenantId])
  @@index([eventType])
  @@index([traceId])
  @@index([source])
}
