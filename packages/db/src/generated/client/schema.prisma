generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  tenantId     String?
  expires      DateTime
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model User {
  id                        String                    @id @default(cuid())
  name                      String?
  email                     String?                   @unique
  emailVerified             DateTime?
  image                     String?
  hashedPassword            String?
  isEmailVerified           Boolean                   @default(false)
  emailVerificationToken    String?                   @unique
  passwordResetToken        String?                   @unique
  passwordResetExpires      DateTime?
  platformRole              String?
  status                    String                    @default("active")
  lastLoginAt               DateTime?
  twoFactorSecret           String?
  twoFactorEnabled          Boolean                   @default(false)
  bio                       String?
  location                  String?
  website                   String?
  timezone                  String                    @default("UTC")
  locale                    String                    @default("en")
  emailNotifications        Boolean                   @default(true)
  marketingEmails           Boolean                   @default(false)
  securityAlerts            Boolean                   @default(true)
  activityUpdates           Boolean                   @default(false)
  notifySupportRepliesUI    Boolean                   @default(true)
  notifySupportRepliesEmail Boolean                   @default(true)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  accounts                  Account[]
  auditLogs                 AuditLog[]
  authenticatorCodes        AuthenticatorCode[]
  caseMetrics               CaseMetrics[]             @relation("CaseMetricsAssignee")
  caseStatusChanges         CaseStatusHistory[]       @relation("StatusChangedBy")
  contactMessages           ContactMessage[]
  acceptedInvitations       Invitation[]              @relation("InvitationAcceptedBy")
  sentInvitations           Invitation[]              @relation("InvitedBy")
  dashboardLayouts          DashboardLayout[]
  invitedMemberships        Membership[]              @relation("InvitedBy")
  memberships               Membership[]
  notifications             Notification[]
  notificationRecipients    NotificationRecipient[]
  notificationPreferences   NotificationPreferences[]
  passkeys                  Passkey[]
  pendingAuths              PendingAuth[]
  sessions                  Session[]
  ssoAuditLogs              SsoAuditLog[]
  assignedCases             SupportCase[]             @relation("CaseAssignee")
  twoFactorAudits           TwoFactorAudit[]
  twoFactorCodes            TwoFactorCode[]
  twoFactorMethods          TwoFactorMethod[]
  createdEmailProviders     EmailProvider[]
  orders                    Order[]
  subscriptions             Subscription[]

  @@index([email])
  @@index([platformRole])
  @@index([status])
  @@index([lastLoginAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Tenant {
  id                             String                    @id @default(cuid())
  slug                           String                    @unique
  name                           String
  status                         String                    @default("active")
  subdomain                      String?                   @unique
  customDomain                   String?                   @unique
  logoUrl                        String?
  theme                          String?
  primaryColor                   String?
  secondaryColor                 String?
  invitePolicy                   String                    @default("admin_only")
  emailVerificationBypassEnabled Boolean                   @default(false)
  locale                         String                    @default("en")
  timezone                       String                    @default("UTC")
  plan                           String                    @default("free")
  limits                         String?
  featureFlags                   String?
  ssoEnabled                     Boolean                   @default(false)
  ssoProvider                    String?
  billingEnabled                 Boolean                   @default(false)
  stripeCustomerId               String?
  currentPeriodStart             DateTime?
  currentPeriodEnd               DateTime?
  cancelAtPeriodEnd              Boolean                   @default(false)
  description                    String?
  website                        String?
  industry                       String?
  size                           String?
  contactEmail                   String?
  createdAt                      DateTime                  @default(now())
  updatedAt                      DateTime                  @updatedAt
  suspendedAt                    DateTime?
  deletedAt                      DateTime?
  domainAlias                    String?                   @unique
  registrationClosed             Boolean                   @default(false)
  auditLogs                      AuditLog[]
  caseMetrics                    CaseMetrics[]
  contactMessages                ContactMessage[]
  contactReasons                 ContactReason[]
  featureAuditEntries            FeatureAuditEntry[]
  invitations                    Invitation[]
  memberships                    Membership[]
  notifications                  Notification[]
  notificationIntents            NotificationIntent[]
  notificationPreferences        NotificationPreferences[]
  dashboardLayouts               DashboardLayout[]
  pendingAuths                   PendingAuth[]
  sessions                       Session[]
  ssoAuditLogs                   SsoAuditLog[]
  supportCases                   SupportCase[]
  supportConfigurations          SupportConfiguration[]
  supportOptions                 SupportOption[]
  featureRules                   TenantFeatureRule[]
  ssoConfiguration               TenantSsoConfiguration?
  supportRouting                 TenantSupportRouting[]
  twoFactorAudits                TwoFactorAudit[]
  twoFactorCodes                 TwoFactorCode[]
  twoFactorMethods               TwoFactorMethod[]
  webhookEndpoints               WebhookEndpoint[]
  orders                         Order[]
  subscriptions                  Subscription[]
  orderConfigurations            OrderConfiguration[]

  @@index([slug])
  @@index([subdomain])
  @@index([status])
  @@index([plan])
  @@index([createdAt])
  @@index([suspendedAt])
  @@index([deletedAt])
}

model TenantSsoConfiguration {
  id                   String    @id @default(cuid())
  tenantId             String    @unique
  provider             String
  providerName         String
  isEnabled            Boolean   @default(false)
  enforceSSO           Boolean   @default(false)
  samlEntityId         String?
  samlSsoUrl           String?
  samlSloUrl           String?
  samlCertificate      String?
  samlSigningCert      String?
  samlNameIdFormat     String?
  samlAttributeMapping Json?
  oidcIssuer           String?
  oidcClientId         String?
  oidcClientSecret     String?
  oidcScopes           String?
  oidcTokenEndpoint    String?
  oidcAuthEndpoint     String?
  oidcUserinfoEndpoint String?
  oidcJwksUri          String?
  oauth2ClientId       String?
  oauth2ClientSecret   String?
  oauth2AuthUrl        String?
  oauth2TokenUrl       String?
  oauth2UserInfoUrl    String?
  oauth2Scopes         String?
  autoProvisionUsers   Boolean   @default(true)
  defaultRole          String    @default("member")
  allowedDomains       String?
  userAttributeMapping Json?
  signAssertions       Boolean   @default(true)
  signRequests         Boolean   @default(false)
  encryptAssertions    Boolean   @default(false)
  sessionTimeout       Int?      @default(480)
  lastSyncAt           DateTime?
  lastLoginAt          DateTime?
  totalLogins          Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  createdBy            String
  updatedBy            String
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([provider])
  @@index([isEnabled])
}

model SsoAuditLog {
  id             String   @id @default(cuid())
  tenantId       String
  userId         String?
  event          String
  provider       String
  ipAddress      String?
  userAgent      String?
  samlRequestId  String?
  samlResponseId String?
  errorMessage   String?
  attributes     Json?
  sessionId      String?
  createdAt      DateTime @default(now())
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([event])
  @@index([provider])
  @@index([createdAt])
}

model Membership {
  id                   String    @id @default(cuid())
  tenantId             String
  userId               String
  role                 String
  status               String    @default("active")
  permissions          String?
  invitedByUserId      String?
  invitationAcceptedAt DateTime?
  lastActiveAt         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  invitedBy            User?     @relation("InvitedBy", fields: [invitedByUserId], references: [id])
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@index([role])
  @@index([status])
  @@index([lastActiveAt])
}

model Invitation {
  id                      String    @id @default(cuid())
  tenantId                String
  email                   String
  role                    String
  token                   String    @unique
  expiresAt               DateTime
  bypassEmailVerification Boolean   @default(false)
  status                  String    @default("pending")
  message                 String?
  acceptedAt              DateTime?
  acceptedByUserId        String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  invitedByUserId         String
  acceptedBy              User?     @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id])
  invitedBy               User      @relation("InvitedBy", fields: [invitedByUserId], references: [id])
  tenant                  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([email])
  @@index([token])
  @@index([status])
  @@index([expiresAt])
  @@index([createdAt])
}

model ContactReason {
  id              String                 @id @default(cuid())
  key             String                 @unique
  label           String
  description     String
  icon            String
  helpType        String                 @default("general")
  isActive        Boolean                @default(true)
  sortOrder       Int                    @default(0)
  tenantId        String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  contactMessages ContactMessageReason[]
  tenant          Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([isActive])
  @@index([sortOrder])
  @@index([helpType])
}

model ContactMessage {
  id          String                 @id @default(cuid())
  name        String
  email       String
  subject     String
  message     String
  userId      String?
  tenantId    String?
  status      String                 @default("open")
  priority    String                 @default("normal")
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  assignedTo  String?
  category    String?
  dueDate     DateTime?
  resolvedAt  DateTime?
  tags        String?
  tenant      Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User?                  @relation(fields: [userId], references: [id])
  reasons     ContactMessageReason[]
  replies     ContactReply[]
  supportCase SupportCase?

  @@index([userId])
  @@index([tenantId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([assignedTo])
  @@index([createdAt])
  @@index([resolvedAt])
}

model ContactMessageReason {
  id               String         @id @default(cuid())
  contactMessageId String
  contactReasonId  String
  createdAt        DateTime       @default(now())
  contactMessage   ContactMessage @relation(fields: [contactMessageId], references: [id], onDelete: Cascade)
  contactReason    ContactReason  @relation(fields: [contactReasonId], references: [id], onDelete: Cascade)

  @@unique([contactMessageId, contactReasonId])
  @@index([contactMessageId])
  @@index([contactReasonId])
}

model ContactReply {
  id               String         @id @default(cuid())
  contactMessageId String
  message          String
  isFromUser       Boolean        @default(false)
  isInternal       Boolean        @default(false)
  attachments      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  caseMessages     CaseMessage[]
  contactMessage   ContactMessage @relation(fields: [contactMessageId], references: [id], onDelete: Cascade)

  @@index([contactMessageId])
  @@index([isFromUser])
  @@index([isInternal])
  @@index([createdAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  tenantId     String?
  userId       String?
  action       String
  resourceType String?
  resourceId   String?
  details      String?
  ipAddress    String?
  userAgent    String?
  metadata     String?
  severity     String   @default("info")
  createdAt    DateTime @default(now())
  traceId      String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([resourceType])
  @@index([severity])
  @@index([createdAt])
}

model Passkey {
  id               String    @id @default(cuid())
  userId           String
  name             String
  credentialId     String    @unique
  publicKey        String
  signCount        Int       @default(0)
  transports       String?
  backupEligible   Boolean   @default(false)
  backupState      Boolean   @default(false)
  userVerification String    @default("preferred")
  rpId             String?
  isActive         Boolean   @default(true)
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([credentialId])
  @@index([isActive])
  @@index([lastUsedAt])
  @@index([rpId])
  @@index([createdAt])
}

model AuthenticatorCode {
  id         String    @id @default(cuid())
  userId     String
  name       String
  secret     String
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@index([createdAt])
}

model Notification {
  id                String                  @id @default(cuid())
  title             String
  description       String?
  type              String                  @default("info")
  priority          String                  @default("normal")
  status            String                  @default("unread")
  tenantId          String?
  role              String?
  userId            String?
  metadata          String?
  dataJson          Json?
  isAlert           Boolean                 @default(false)
  emailOnly         Boolean                 @default(false)
  templateId        String?
  templateVariables Json?
  expiresAt         DateTime?
  readAt            DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  tenant            Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User?                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipients        NotificationRecipient[]
  deliveries        NotificationDelivery[]
  template          NotificationTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([role])
  @@index([userId])
  @@index([type])
  @@index([priority])
  @@index([status])
  @@index([expiresAt])
  @@index([createdAt])
}

model NotificationRecipient {
  id             String       @id @default(cuid())
  notificationId String
  userId         String
  status         String       @default("unread")
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([notificationId])
  @@index([userId])
  @@index([status])
  @@index([readAt])
  @@index([createdAt])
}

model WebhookEndpoint {
  id              String    @id @default(cuid())
  tenantId        String?
  name            String
  url             String
  secret          String?
  events          String
  isActive        Boolean   @default(true)
  lastTriggeredAt DateTime?
  failureCount    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tenant          Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([isActive])
  @@index([lastTriggeredAt])
  @@index([createdAt])
}

model FeatureDefinition {
  id             String              @id @default(cuid())
  key            String              @unique
  name           String
  description    String?
  tier           String
  defaultEnabled Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  createdBy      String
  auditEntries   FeatureAuditEntry[]
  globalRules    GlobalFeatureRule?
  tenantRules    TenantFeatureRule[]

  @@index([tier])
  @@index([defaultEnabled])
  @@index([createdAt])
}

model GlobalFeatureRule {
  id         String            @id @default(cuid())
  featureKey String            @unique
  enabled    Boolean
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  createdBy  String
  feature    FeatureDefinition @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  @@index([enabled])
  @@index([createdAt])
}

model TenantFeatureRule {
  id         String            @id @default(cuid())
  tenantId   String
  featureKey String
  enabled    Boolean
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  createdBy  String
  feature    FeatureDefinition @relation(fields: [featureKey], references: [key], onDelete: Cascade)
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, featureKey])
  @@index([tenantId])
  @@index([enabled])
  @@index([createdAt])
}

model FeatureAuditEntry {
  id          String            @id @default(cuid())
  featureKey  String
  scope       String
  tenantId    String?
  beforeValue String?
  afterValue  String?
  action      String
  createdAt   DateTime          @default(now())
  createdBy   String
  feature     FeatureDefinition @relation(fields: [featureKey], references: [key], onDelete: Cascade)
  tenant      Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([featureKey])
  @@index([scope])
  @@index([tenantId])
  @@index([createdAt])
  @@index([createdBy])
}

model SetupState {
  id              String    @id @default("singleton")
  isCompleted     Boolean   @default(false)
  currentStep     String?
  contextSnapshot String?
  completedAt     DateTime?
  completedBy     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isCompleted])
  @@index([completedAt])
}

model TwoFactorMethod {
  id          String    @id @default(cuid())
  userId      String
  tenantId    String?
  type        String
  identifier  String?
  secret      String?
  isVerified  Boolean   @default(false)
  isEnabled   Boolean   @default(false)
  backupCodes String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastUsedAt  DateTime?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, tenantId])
  @@index([userId])
  @@index([type])
  @@index([tenantId])
}

model PendingAuth {
  id              String   @id @default(cuid())
  userId          String
  tenantId        String?
  nonce           String   @unique
  requiredFactors String
  createdAt       DateTime @default(now())
  expiresAt       DateTime
  ipAddress       String?
  userAgent       String?
  tenant          Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([nonce])
  @@index([expiresAt])
  @@index([tenantId])
}

model TwoFactorCode {
  id          String    @id @default(cuid())
  userId      String
  tenantId    String?
  type        String
  codeHash    String
  salt        String
  purpose     String
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?
  traceId     String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([purpose])
  @@index([expiresAt])
  @@index([tenantId])
  @@index([traceId])
}

model TwoFactorAudit {
  id         String   @id @default(cuid())
  userId     String
  tenantId   String?
  action     String
  factorType String
  success    Boolean
  ipAddress  String?
  userAgent  String?
  metadata   String?
  createdAt  DateTime @default(now())
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([factorType])
  @@index([createdAt])
  @@index([tenantId])
}

model SupportCase {
  id               String              @id @default(cuid())
  contactMessageId String?             @unique
  caseNumberSeq    Int                 @unique @default(autoincrement())
  caseNumber       String?             @unique
  title            String
  description      String?
  status           String              @default("OPEN")
  priority         String              @default("NORMAL")
  assigneeId       String?
  tenantId         String?
  supportOptionId  String?
  threadingKey     String?             @unique
  source           String              @default("CONTACT_FORM")
  sourceMetadata   Json?
  firstResponseAt  DateTime?
  resolvedAt       DateTime?
  closedAt         DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  messages         CaseMessage[]
  statusHistory    CaseStatusHistory[]
  assignee         User?               @relation("CaseAssignee", fields: [assigneeId], references: [id])
  contactMessage   ContactMessage?     @relation(fields: [contactMessageId], references: [id])
  supportOption    SupportOption?      @relation(fields: [supportOptionId], references: [id])
  tenant           Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([assigneeId])
  @@index([tenantId])
  @@index([threadingKey])
  @@index([createdAt])
  @@index([source])
  @@index([priority])
}

model SupportOption {
  id             String          @id @default(cuid())
  key            String          @unique
  label          String
  description    String?
  icon           String?
  isActive       Boolean         @default(true)
  isGlobal       Boolean         @default(true)
  tenantId       String?
  parentOptionId String?
  sortOrder      Int             @default(0)
  isHidden       Boolean         @default(false)
  routingConfig  Json
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  metrics        CaseMetrics[]
  cases          SupportCase[]
  parent         SupportOption?  @relation("OptionHierarchy", fields: [parentOptionId], references: [id])
  children       SupportOption[] @relation("OptionHierarchy")
  tenant         Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key], name: "tenant_key")
  @@index([tenantId])
  @@index([isActive])
  @@index([parentOptionId])
  @@index([sortOrder])
}

model CaseMessage {
  id               String        @id @default(cuid())
  caseId           String
  contactReplyId   String?
  direction        String
  channel          String
  fromAddress      String?
  toAddress        String?
  subject          String?
  content          String
  isInternal       Boolean       @default(false)
  messageId        String?
  threadingData    Json?
  attachments      Json?
  deliveryStatus   String?       @default("PENDING")
  deliveryMetadata Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  case             SupportCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  contactReply     ContactReply? @relation(fields: [contactReplyId], references: [id])

  @@index([caseId])
  @@index([createdAt])
  @@index([direction])
  @@index([messageId])
  @@index([channel])
  @@index([deliveryStatus])
}

model CaseStatusHistory {
  id         String      @id @default(cuid())
  caseId     String
  fromStatus String?
  toStatus   String
  changedBy  String?
  reason     String?
  metadata   Json?
  createdAt  DateTime    @default(now())
  case       SupportCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user       User?       @relation("StatusChangedBy", fields: [changedBy], references: [id])

  @@index([caseId])
  @@index([createdAt])
  @@index([toStatus])
}

model CaseMetrics {
  id                   String         @id @default(cuid())
  tenantId             String?
  date                 DateTime       @db.Date
  supportOptionId      String?
  assigneeId           String?
  totalCases           Int            @default(0)
  openCases            Int            @default(0)
  pendingCases         Int            @default(0)
  resolvedCases        Int            @default(0)
  closedCases          Int            @default(0)
  avgFirstResponseTime Int?
  avgResolutionTime    Int?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  assignee             User?          @relation("CaseMetricsAssignee", fields: [assigneeId], references: [id])
  supportOption        SupportOption? @relation(fields: [supportOptionId], references: [id])
  tenant               Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date, supportOptionId, assigneeId])
  @@index([date])
  @@index([tenantId])
}

model SupportConfiguration {
  id          String   @id @default(cuid())
  tenantId    String?
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key], name: "tenant_config_key")
  @@index([tenantId])
}

model TenantSupportRouting {
  id        String   @id @default(cuid())
  tenantId  String
  helpType  String
  email     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, helpType])
  @@index([tenantId])
  @@index([helpType])
  @@index([isActive])
}

model OutboxEvent {
  id             Int      @id @default(autoincrement())
  eventType      String
  aggregateType  String
  aggregateId    String
  tenantId       String? // Allow null for cross-tenant/platform events
  payloadJson    Json
  idempotencyKey String?  @unique
  status         String   @default("pending")
  tries          Int      @default(0)
  nextAttemptAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastError      String?
  traceId        String?

  @@index([status, nextAttemptAt])
  @@index([tenantId])
  @@index([eventType])
  @@index([traceId])
}

// Admin Order Configuration System
model OrderConfiguration {
  id       String  @id @default(cuid())
  tenantId String? // null = platform-level configuration

  // Basic configuration
  name             String // "Pro Plan", "Enterprise", "One-time Setup"
  slug             String // URL-friendly identifier
  description      String?
  shortDescription String? // For cards/listings

  // Features and metadata
  features String[] // JSON array of feature strings
  metadata Json? // Additional configuration data

  // Terms and legal
  termsContent  String? // HTML/Markdown terms specific to this order type
  requiresTerms Boolean @default(true)

  // Display and ordering
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)
  isPublic     Boolean @default(true) // Show on public pricing pages

  // Category and type
  category String? // "subscription", "one-time", "setup", etc.
  tags     String[] // For filtering/organization

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant         Tenant?                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pricingOptions OrderConfigurationPricing[]
  orders         Order[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([isActive])
  @@index([isPublic])
  @@index([category])
  @@index([displayOrder])
}

model OrderConfigurationPricing {
  id                   String @id @default(cuid())
  orderConfigurationId String

  // Pricing details
  name     String // "Monthly", "Yearly", "One-time"
  amount   Int // in cents
  currency String @default("gbp")

  // Subscription configuration
  frequency   SubscriptionFrequency?
  isRecurring Boolean                @default(false)

  // Discounts and promotions
  discountPercent     Int?    @default(0) // 0-100
  discountAmount      Int? // Alternative to percentage, in cents
  discountDescription String? // "20% off first year"

  // Trial and setup
  trialDays Int? @default(0)
  setupFee  Int? @default(0) // One-time setup fee in cents

  // Display
  displayOrder Int     @default(0)
  isDefault    Boolean @default(false) // Default selection
  isPopular    Boolean @default(false) // Highlight as popular
  isActive     Boolean @default(true)

  // Stripe integration
  stripePriceId   String? // Link to Stripe Price ID for subscriptions
  stripeProductId String? // Link to Stripe Product ID

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  orderConfiguration OrderConfiguration @relation(fields: [orderConfigurationId], references: [id], onDelete: Cascade)

  @@index([orderConfigurationId])
  @@index([isActive])
  @@index([displayOrder])
  @@index([frequency])
}

// Order Management System  
enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  PROCESSING
  COMPLETED
  UP_TO_DATE
  CANCELLED
  FAILED
}

enum InvoiceStatus {
  DRAFT
  PENDING
  SENT
  PAID
  OVERDUE
  CANCELLED
  VOID
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum SubscriptionFrequency {
  EVERY_10_MINUTES
  MONTHLY
  QUARTERLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

model Order {
  id                   String  @id @default(cuid())
  tenantId             String?
  userId               String?
  orderConfigurationId String? // Links to admin-defined order configuration

  orderNumber String      @unique
  description String?
  totalAmount Int // in cents
  currency    String      @default("gbp")
  status      OrderStatus @default(DRAFT)
  metadata    Json?

  // Guest checkout information (when no userId)
  guestName  String?
  guestEmail String?

  // Billing information
  billingCompanyName  String?
  billingVatNumber    String?
  billingAddressLine1 String?
  billingAddressLine2 String?
  billingCity         String?
  billingState        String?
  billingPostalCode   String?
  billingCountry      String?

  // Selected pricing option details (snapshot at time of order)
  selectedPricingName    String? // "Monthly", "Yearly", etc.
  selectedPricingAmount  Int? // Snapshot of amount at time of order
  appliedDiscountPercent Int? // Discount applied at time of order
  appliedDiscountAmount  Int? // Discount amount in cents

  // Subscription details (if applicable)
  isSubscription        Boolean                @default(false)
  subscriptionFrequency SubscriptionFrequency?
  subscriptionAutoRenew Boolean                @default(false)
  subscriptionAutoPay   Boolean                @default(false)
  subscriptionStartDate DateTime?
  subscriptionEndDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant             Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderConfiguration OrderConfiguration? @relation(fields: [orderConfigurationId], references: [id], onDelete: SetNull)
  invoices           Invoice[]
  subscription       Subscription?

  @@index([tenantId])
  @@index([userId])
  @@index([orderConfigurationId])
  @@index([status])
  @@index([orderNumber])
  @@index([guestEmail])
  @@index([createdAt])
}

model Invoice {
  id            String        @id @default(cuid())
  orderId       String
  invoiceNumber String        @unique
  description   String?
  amount        Int // in cents
  currency      String        @default("gbp")
  status        InvoiceStatus @default(DRAFT)

  // Pending state control
  isPending Boolean @default(false) // If true, only visible when order is complete

  // Due date and billing period
  issueDate          DateTime  @default(now())
  dueDate            DateTime
  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?

  // Invoice URLs and metadata
  invoiceUrl  String?
  checkoutUrl String?
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([orderId])
  @@index([status])
  @@index([dueDate])
  @@index([invoiceNumber])
  @@index([createdAt])
}

model Payment {
  id              String        @id @default(cuid())
  invoiceId       String
  paymentIntentId String? // Stripe payment intent ID
  amount          Int // in cents
  currency        String        @default("gbp")
  status          PaymentStatus @default(PENDING)

  // Payment method and provider details
  paymentMethod         String? // 'card', 'bank_transfer', etc.
  paymentProvider       String? // 'stripe', 'paypal', etc.
  providerTransactionId String?

  // Failure and retry information
  failureReason String?
  attemptCount  Int     @default(1)
  maxAttempts   Int     @default(3)

  // Refund information
  refundedAmount Int     @default(0)
  refundReason   String?

  // Timestamps
  processedAt DateTime?
  failedAt    DateTime?
  refundedAt  DateTime?

  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([status])
  @@index([paymentIntentId])
  @@index([createdAt])
}

model Subscription {
  id       String  @id @default(cuid())
  orderId  String  @unique
  tenantId String?
  userId   String?

  // Subscription configuration
  frequency SubscriptionFrequency
  amount    Int // in cents
  currency  String                @default("gbp")
  status    SubscriptionStatus    @default(ACTIVE)

  // Billing cycle
  startDate       DateTime
  endDate         DateTime?
  nextBillingDate DateTime
  lastBillingDate DateTime?

  // Auto-renewal and payment settings
  autoRenew Boolean @default(true)
  autoPay   Boolean @default(false)

  // Stripe integration
  stripeSubscriptionId String? @unique

  // Temporal workflow tracking
  workflowId    String? // Temporal workflow ID for billing
  workflowRunId String? // Temporal run ID

  // Trial and promotional settings
  trialEndDate    DateTime?
  discountPercent Int? // 0-100
  discountEndDate DateTime?

  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  order  Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([nextBillingDate])
  @@index([workflowId])
  @@index([createdAt])
}

model EmailProvider {
  id        String  @id @default(cuid())
  type      String // 'mailgun', 'sendgrid', 'smtp', 'jetstream'
  enabled   Boolean @default(false)
  isDefault Boolean @default(false)

  // Common fields
  fromName     String?
  fromEmail    String?
  replyToEmail String?

  // Provider specific configuration (JSON)
  config Json // Encrypted sensitive data

  // Connection status
  isConnected    Boolean   @default(false)
  lastTested     DateTime?
  lastTestResult String?

  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  // Relations
  createdBy User? @relation(fields: [createdById], references: [id])

  @@unique([type])
  @@index([type])
  @@index([enabled])
  @@index([isDefault])
}

model AuditEvent {
  id                 String   @id
  eventType          String
  eventName          String
  tenantId           String
  userId             String?
  aggregateType      String
  aggregateId        String
  timestamp          DateTime
  sourceService      String
  sourceVersion      String?
  sourceHost         String?
  requestId          String?
  correlationId      String?
  actorType          String?
  actorId            String?
  actorName          String?
  actorEmail         String?
  actorIpAddress     String?
  actorUserAgent     String?
  resourceType       String?
  resourceId         String?
  resourceName       String?
  resourceAttributes String?
  actionType         String
  actionDescription  String?
  actionOutcome      String
  actionReason       String?
  metadata           String?
  originalPayload    String
  createdAt          DateTime @default(now())
  traceId            String?

  @@index([tenantId, timestamp])
  @@index([eventType, timestamp])
  @@index([userId, timestamp])
  @@index([actorId, timestamp])
  @@index([resourceType, resourceId])
  @@index([actionOutcome, timestamp])
  @@index([createdAt])
}

model InboxEvent {
  id             Int      @id @default(autoincrement())
  eventType      String
  aggregateType  String
  aggregateId    String
  tenantId       String?
  payloadJson    Json
  idempotencyKey String?  @unique
  status         String   @default("received")
  tries          Int      @default(0)
  nextAttemptAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  lastError      String?
  traceId        String?
  source         String?
  sourceId       String?

  @@index([status, nextAttemptAt])
  @@index([tenantId])
  @@index([eventType])
  @@index([traceId])
  @@index([source])
}

model NotificationIntent {
  id             String    @id @default(cuid())
  tenantId       String?
  type           String
  recipients     Json // Array of user IDs or roles (supports global/tenant/role targeting)
  channels       Json? // Array of delivery channels: ['email', 'web', 'sms']
  payloadJson    Json
  createdAt      DateTime  @default(now())
  processedAt    DateTime?
  status         String    @default("pending")
  errorMessage   String?
  retryCount     Int       @default(0)
  maxRetries     Int       @default(3)
  traceId        String?
  idempotencyKey String?   @unique
  expiresAt      DateTime?
  tenant         Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([idempotencyKey])
}

model NotificationDelivery {
  id             String       @id @default(cuid())
  notificationId String
  channel        String // realtime, email, sms, whatsapp
  status         String       @default("pending") // pending, sent, failed
  tries          Int          @default(0)
  maxTries       Int          @default(3)
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  metadata       Json?
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([channel])
  @@index([status])
  @@index([createdAt])
}

model NotificationPreferences {
  id              String   @id @default(cuid())
  userId          String
  tenantId        String?
  type            String // notification type or wildcard
  channels        String[] @default(["realtime"])
  emailEnabled    Boolean  @default(true)
  realtimeEnabled Boolean  @default(true)
  smsEnabled      Boolean  @default(false)
  whatsappEnabled Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant          Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId, type])
  @@index([userId])
  @@index([tenantId])
  @@index([type])
}

model NotificationTemplate {
  id            String         @id @default(cuid())
  type          String
  locale        String         @default("en")
  subject       String
  html          String?
  text          String?
  variables     String[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  notifications Notification[]

  @@unique([type, locale])
  @@index([type])
  @@index([locale])
}

model DashboardLayout {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String?
  dashboard String // 'system-health' | 'billing'
  layout    Json // GridStack layout configuration
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, dashboard], name: "platform_layout")
  @@unique([userId, tenantId, dashboard], name: "tenant_layout")
  @@index([userId])
  @@index([tenantId])
  @@index([dashboard])
}
