# Database
# For development with SQLite:
DATABASE_URL="file:./dev.db"
# For development with PostgreSQL (Docker):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/authless"
# For production, use your PostgreSQL connection string:
# DATABASE_URL="postgresql://username:password@host:port/database"

# NextAuth
NEXTAUTH_SECRET="changeme"
NEXTAUTH_URL="http://localhost:3000"

# JWT Secret for email tokens
JWT_SECRET="your-jwt-secret-here"

# Webhooks for email services
REGISTRATION_WEBHOOK_URL=""
PASSWORD_RESET_WEBHOOK_URL=""

# GitHub OAuth (optional)
GITHUB_ID=""
GITHUB_SECRET=""

# Google OAuth (optional)
GOOGLE_ID=""
GOOGLE_SECRET=""

# WhatsApp 2FA Configuration
WHATSAPP_2FA_WEBHOOK_URL=""
WHATSAPP_2FA_WEBHOOK_SECRET=""

# 2FA Security Settings
TWO_FA_CODE_TTL_SECONDS=300
TWO_FA_MAX_ATTEMPTS=5
