# Database Configuration
# Note: PostgreSQL via PgBouncer connection pooling
# Direct PostgreSQL: postgresql://postgres:postgres@localhost:5433/authless
# Via PgBouncer (recommended): postgresql://postgres:postgres@localhost:5432/authless
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/authless"

# Auth Configuration
NEXTAUTH_SECRET="your-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"

# Stripe Configuration (Required for payments)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Optional: Stripe Environment
STRIPE_ENVIRONMENT="test"

# Email Configuration (Optional)
EMAIL_FROM="noreply@yourdomain.com"
SMTP_HOST="smtp.yourdomain.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-user"
SMTP_PASSWORD="your-smtp-password"

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Authless - Advanced SaaS Architecture Foundation"

# NATS JetStream Configuration (Custom ports from docker-compose.yml)
NATS_URL="nats://127.0.0.1:4223"
NATS_STREAM_NAME="EVENTS"

# Centrifugo Real-time Configuration
CENTRIFUGO_URL="http://localhost:8000"
CENTRIFUGO_API_URL="http://localhost:8000"
CENTRIFUGO_API_KEY="your-api-key-change-in-production"
CENTRIFUGO_TOKEN_HMAC_SECRET_KEY="your-secret-key-change-in-production"

# Temporal Workflow Engine
TEMPORAL_ADDRESS="localhost:7233"
TEMPORAL_TASK_QUEUE="hello-world-queue"

# Feature Flags
ENABLE_STRIPE_PAYMENTS="true"
ENABLE_SUBSCRIPTIONS="true"
ENABLE_REALTIME_NOTIFICATIONS="true"
ENABLE_EVENT_SOURCING="true"

# Service Configuration
# Outbox processor settings
OUTBOX_BATCH_SIZE="100"
OUTBOX_MAX_TRIES="10"
OUTBOX_IDLE_SLEEP_MS="500"

# Development/Production Mode
NODE_ENV="development"
LOG_LEVEL="info"